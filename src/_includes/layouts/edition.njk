---
layout: base.njk
eleventyComputed:
  footer:
    # The footer closes the numbering of the sections: About 01, Key dates when there are some,
    # Program when shown (same condition as showProgram below), Report and Photos when there are
    # some, then Contact.
    number: "{{ '0' ~ (2 + (1 if (edition.milestones | length) else 0) + (1 if (edition.program or edition.status == 'upcoming') else 0) + (1 if edition.report else 0) + (1 if edition.photos else 0)) }}"
---
{#- Page of one edition: its entry of src/_data/editions.yml, passed as "edition" by the template
    src/editions/edition.njk, and its program in src/_data/programs/. Styles: src/assets/css/edition.css.
    Always shown: the head (status, version, the label as a poster: name or "FRS <year>", then the city
    across the page) with the dates (TBA while unknown), and About (the summary, or a lorem placeholder
    until the team writes it). For the next edition the head also gives the venue (TBA while unknown),
    the call for abstracts (a link, or TBA) and the registration (a link, or "Not open yet"), as the blue
    band of the home. Shown when there are data: host, venue and participants in the head; the key
    dates (milestones), with their state set by hand; the program ("Program TBA" for the next edition until it exists); the final report, paragraphs written by
    the team; the photos, in src/_data/photos/; the funding band, which carries the
    funder's wording and logos unchanged. The next edition stands on the blue field, past ones on paper. -#}
{%- from "placeholder.njk" import placeholder -%}
{%- from "section-head.njk" import sectionHead -%}
{%- from "program.njk" import programDays -%}
{%- if not edition.slug %}{{ "edition: an entry of editions.yml has no slug" | fail }}{% endif -%}
{%- if not (edition.status in ["upcoming", "past"]) %}{{ ('edition "' + edition.slug + '": status must be upcoming or past') | fail }}{% endif -%}
{%- set isNext = edition.status == "upcoming" -%}
{%- set program = programs[edition.program] if edition.program else null -%}
{%- if edition.program and not program %}{{ ('edition "' + edition.slug + '": no program "' + edition.program + '" in src/_data/programs/') | fail }}{% endif -%}
{%- set showProgram = program or isNext -%}
{%- set gallery = photos[edition.photos] if edition.photos else null -%}
{%- if edition.photos and not gallery %}{{ ('edition "' + edition.slug + '": no photos "' + edition.photos + '" in src/_data/photos/') | fail }}{% endif -%}
{%- for photo in (gallery.items if gallery else []) %}{% if not (photo.name and photo.width and photo.height and photo.alt) %}{{ ('edition "' + edition.slug + '": every photo needs name, width, height and alt') | fail }}{% endif %}{% endfor -%}
{%- set milestones = edition.milestones or [] -%}
{%- for milestone in milestones %}{% if not milestone.label %}{{ ('edition "' + edition.slug + '": every milestone needs a label') | fail }}{% endif %}{% if not (milestone.state in ["upcoming", "open", "closed"]) %}{{ ('edition "' + edition.slug + '": the state of a milestone must be upcoming, open or closed') | fail }}{% endif %}{% endfor -%}
{%- set funding = edition.funding -%}
{%- if funding and funding.image and not (funding.image_width and funding.image_height and funding.image_alt) %}{{ ('edition "' + edition.slug + '": the funding image needs image_width, image_height and image_alt') | fail }}{% endif -%}
{%- set num = 0 %}
<header class="edition-hero{% if isNext %} surface-accent{% endif %}">
    <div class="wrap">
        <p class="edition-hero-meta">
            <span class="label">{{ "Next edition" if isNext else "Past edition" }}</span>
            {%- if edition.version %}
            <span class="edition-hero-version">{{ edition.version }}</span>
            {%- endif %}
        </p>
        {#- The poster of the blue band of the home (next-edition.css), on paper for a past edition #}
        <h1 class="next-band-poster edition-hero-title" id="page-title">
            <span class="next-band-kicker">{% if edition.name %}{{ edition.name }}{% else %}{{ site.short_name }} {{ edition.year or placeholder("tba") }}{% endif %}</span>
            <span class="next-band-city chars-{{ edition.city | fitChars }}">{{ edition.city or placeholder("tba") }}</span>
        </h1>
        <dl class="edition-facts">
            <div class="edition-fact">
                <dt class="label">Dates</dt>
                <dd>{% if edition.dates.start %}{{ edition.dates.start | dateRange(edition.dates.end) }}{% else %}{{ placeholder("tba") }}{% endif %}</dd>
            </div>
            {%- if edition.host %}
            <div class="edition-fact">
                <dt class="label">Host</dt>
                <dd>{{ edition.host }}</dd>
            </div>
            {%- endif %}
            {%- if edition.venue.name or edition.venue.address %}
            <div class="edition-fact is-wide">
                <dt class="label">Venue</dt>
                <dd>{{ edition.venue.name }}{% if edition.venue.address %} <span class="edition-fact-detail">{{ edition.venue.address }}</span>{% endif %}</dd>
            </div>
            {%- elif isNext %}
            <div class="edition-fact">
                <dt class="label">Venue</dt>
                <dd>{{ placeholder("tba") }}</dd>
            </div>
            {%- endif %}
            {%- if edition.participants %}
            <div class="edition-fact">
                <dt class="label">Participants</dt>
                <dd>{{ edition.participants }}</dd>
            </div>
            {%- endif %}
            {%- if isNext %}
            <div class="edition-fact">
                <dt class="label">Call for abstracts</dt>
                <dd>{% if edition.links.call %}<a href="{{ edition.links.call }}">Read the call</a>{% else %}{{ placeholder("tba") }}{% endif %}</dd>
            </div>
            <div class="edition-fact">
                <dt class="label">Registration</dt>
                <dd>{% if edition.links.registration %}<a href="{{ edition.links.registration }}">Register</a>{% else %}Not open yet{% endif %}</dd>
            </div>
            {%- endif %}
        </dl>
    </div>
</header>
{%- set num = num + 1 %}

<section id="about" class="section" aria-labelledby="about-title">
    <div class="wrap">
        {{ sectionHead("About", "about-title", "0" ~ num) }}
        <div class="edition-body">
            {%- if edition.summary %}
            <p class="edition-summary">{{ edition.summary }}</p>
            {%- else %}
            {{ placeholder("lorem", null, "edition-summary") }}
            {%- endif %}
        </div>
    </div>
</section>
{%- if milestones | length %}
{%- set num = num + 1 %}

<section id="key-dates" class="section section-flush-top" aria-labelledby="key-dates-title">
    <div class="wrap">
        {{ sectionHead("Key dates", "key-dates-title", "0" ~ num) }}
        <div class="edition-body">
            <ol class="edition-milestones">
                {%- for milestone in milestones %}
                <li class="edition-milestone" data-state="{{ milestone.state }}">
                    <span class="edition-milestone-date">{% if milestone.date %}<time datetime="{{ milestone.date }}">{{ milestone.date | dateRange }}</time>{% else %}{{ placeholder("tba") }}{% endif %}</span>
                    <span class="edition-milestone-label">{{ milestone.label }}</span>
                    <span class="label edition-milestone-state">{{ milestone.state | capitalize }}</span>
                </li>
                {%- endfor %}
            </ol>
        </div>
    </div>
</section>
{%- endif %}
{%- if showProgram %}
{%- set num = num + 1 %}

<section id="program" class="section section-flush-top" aria-labelledby="program-title">
    <div class="wrap">
        {{ sectionHead("Program", "program-title", "0" ~ num) }}
        <div class="edition-body">
            {%- if program %}
            {{ programDays(program) }}
            {%- else %}
            <p class="edition-program-tba">{{ placeholder("tba", "Program", "tba-hollow") }}</p>
            {%- endif %}
        </div>
    </div>
</section>
{%- endif %}
{%- if edition.report %}
{%- set num = num + 1 %}

<section id="report" class="section section-flush-top" aria-labelledby="report-title">
    <div class="wrap">
        {{ sectionHead("Report", "report-title", "0" ~ num) }}
        <div class="edition-body">
            <div class="edition-report">
                {%- for paragraph in edition.report %}
                <p>{{ paragraph }}</p>
                {%- endfor %}
                {%- if edition.report_closing %}
                <p class="edition-report-closing"{% if edition.report_closing.lang %} lang="{{ edition.report_closing.lang }}"{% endif %}>
                    {%- for line in edition.report_closing.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor -%}
                </p>
                {%- endif %}
            </div>
        </div>
    </div>
</section>
{%- endif %}
{%- if gallery %}
{%- set num = num + 1 %}

<section id="photos" class="section section-flush-top" aria-labelledby="photos-title">
    <div class="wrap">
        {{ sectionHead("Photos", "photos-title", "0" ~ num) }}
        <div class="edition-body">
            <ul class="photo-grid">
                {%- for photo in gallery.items %}
                {%- set base = gallery.dir ~ photo.name %}
                <li class="photo">
                    <a href="{{ base }}-1920.jpg"><img src="{{ base }}-960.jpg" srcset="{{ base }}-960.jpg 960w, {{ base }}-1920.jpg 1920w" sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 50vw, 100vw" width="{{ photo.width }}" height="{{ photo.height }}" alt="{{ photo.alt }}" loading="lazy" decoding="async"></a>
                </li>
                {%- endfor %}
            </ul>
        </div>
    </div>
</section>
{%- endif %}
{#- Body of the template, if any (src/editions/edition.njk has none): before the funding band, which closes the page #}
{{ content | safe }}
{%- if funding %}

<section class="funding-band" aria-label="Funding">
    <div class="wrap">
        {%- if funding.text %}
        <p class="funding-band-text">{{ funding.text }}</p>
        {%- endif %}
        {%- if funding.image %}
        <img class="funding-band-logos" src="{{ funding.image | replace(' ', '%20') }}" width="{{ funding.image_width }}" height="{{ funding.image_height }}" alt="{{ funding.image_alt }}" loading="lazy" decoding="async">
        {%- endif %}
    </div>
</section>
{%- endif %}
