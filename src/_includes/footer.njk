{#- Page data (optional): footer.copyright replaces the text after the copyright sign, footer.note adds
    a second, smaller line. -#}
<footer>
    <div class="container">
        <p>&copy; {{ footer.copyright or "2025 Fostering Research Synergies. All rights reserved." }}</p>
        {%- if footer.note %}
        <p class="footer-note">{{ footer.note }}</p>
        {%- endif %}
    </div>
</footer>
