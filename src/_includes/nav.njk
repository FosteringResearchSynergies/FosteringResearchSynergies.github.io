{#- Main navigation, rendered in the HTML (no JavaScript). Five short items: at 320px they fit on one
    line under the brand. An item is the current page (aria-current="page") on its own URL and, with
    "section", the current section (aria-current="true") on every page under that path: Editions is
    the page on the archive /editions/ and the section on the page of each edition. -#}
{%- set navItems = [
    { label: "Home", href: "/" },
    { label: "Editions", href: "/editions/", section: "/editions/" },
    { label: "About", href: "/about.html" },
    { label: "Press", href: "/press/" },
    { label: "Contact", href: "/contact.html" }
] -%}
<nav class="site-nav" aria-label="Main">
    <ul>
        {%- for item in navItems %}
        {%- set isCurrent = page.url == item.href %}
        {%- set inSection = item.section and page.url.startsWith(item.section) %}
        <li><a href="{{ item.href }}"{% if isCurrent %} aria-current="page"{% elif inSection %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
    </ul>
</nav>
