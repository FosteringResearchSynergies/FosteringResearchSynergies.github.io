{#- Page data: title (required); stylesheets (optional list of extra stylesheet URLs, loaded after
    main.css: the layout "page" adds /styles.css for the pages ported from the old static site). The
    font of the titles is preloaded: the home title is set in it and is the largest element of the page. -#}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="preload" href="/assets/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/main.css">
{%- for href in stylesheets %}
<link rel="stylesheet" href="{{ href }}">
{%- endfor %}
