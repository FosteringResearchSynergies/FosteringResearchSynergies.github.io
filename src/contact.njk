            <dl class="page-facts">
                <div class="page-fact">
                    <dt class="label">Email</dt>
                    <dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd>
                </div>
                <!-- TODO(team): esistono account social reali? Se sì, aggiungere i link qui. -->
                <div class="page-fact">
                    <dt class="label">Mailing List</dt>
                    <dd>{{ placeholder("unbuilt", "mailing list.") }}</dd>
                </div>
            </dl>
        </div>
    </div>
</section>

<section class="section section-flush-top" aria-labelledby="message-title">
    <div class="wrap">
        {{ sectionHead("Send Us a Message", "message-title", "02") }}
        <div class="page-body">
            {% call placeholder("unbuilt") %}contact form. Please write to <a href="mailto:{{ site.email }}">{{ site.email }}</a>.{% endcall %}
        </div>
    </div>
</section>

<section class="section section-flush-top" aria-labelledby="committee-title">
    <div class="wrap">
        {{ sectionHead("Organizing Committee", "committee-title", "03") }}
        <div class="page-body">
