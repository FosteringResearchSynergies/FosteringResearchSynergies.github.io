{%- from "section-head.njk" import sectionHead -%}
<div class="page-head">
    <div class="wrap">
        <h1 class="page-title" id="page-title">About Our Network</h1>
        <p class="page-lede">Building bridges in early-career research</p>
    </div>
</div>

<section class="section section-flush-top" aria-labelledby="mission-title">
    <div class="wrap">
        {{ sectionHead("Our Mission", "mission-title", "01") }}
        <div class="page-body">
            <p class="page-text is-large">Fostering Research Synergies is an informal association dedicated to fostering collaboration, knowledge sharing, and professional development among early-career researchers. We believe that bringing together talented PhD students and postdoctoral researchers creates opportunities for meaningful scientific exchange and lasting professional relationships.</p>
        </div>
    </div>
</section>

<section class="section section-flush-top" aria-labelledby="what-title">
    <div class="wrap">
        {{ sectionHead("What We Do", "what-title", "02") }}
        <div class="page-body">
            <p class="page-text">We organize small-scale workshops and conferences <span class="nowrap">1-2</span> times per year, carefully designed to:</p>
            <ul class="point-list page-points">
                <li class="point">
                    <h3 class="point-title">Share Research</h3>
                    <p class="point-text">Provide a supportive environment for presenting research findings and receiving constructive feedback from peers.</p>
                </li>
                <li class="point">
                    <h3 class="point-title">Network &amp; Collaborate</h3>
                    <p class="point-text">Create opportunities for interdisciplinary connections that can lead to future collaborations.</p>
                </li>
                <li class="point">
                    <h3 class="point-title">Learn &amp; Grow</h3>
                    <p class="point-text">Offer workshops, keynote talks, and panel discussions on topics relevant to early-career researchers.</p>
                </li>
            </ul>
        </div>
    </div>
</section>

<section class="section section-flush-top" aria-labelledby="community-title">
    <div class="wrap">
        {{ sectionHead("Our Community", "community-title", "03") }}
        <div class="page-body">
            <p class="page-text">Our network brings together researchers from diverse backgrounds and disciplines. Whether you're working in natural sciences, engineering, social sciences, or humanities, you'll find a welcoming community of peers who share your passion for research and discovery.</p>
        </div>
    </div>
</section>

<section class="section section-flush-top" aria-labelledby="involved-title">
    <div class="wrap">
        {{ sectionHead("Get Involved", "involved-title", "04") }}
        <div class="page-body">
            <p class="page-text">There are several ways to participate in our community:</p>
            <ul class="page-list">
                <li>Attend our workshops and conferences</li>
                <li>Present your research through talks or posters</li>
                <li>Join our organizing committee</li>
                <li>Help spread the word about our events</li>
                <li>Suggest topics or speakers for future events</li>
            </ul>
        </div>
    </div>
</section>

<section class="section surface-accent page-callout" aria-labelledby="join-title">
    <div class="wrap">
        <div class="page-body">
            <div>
                <h2 class="page-callout-title" id="join-title">Join the Fostering Movement!</h2>
                <p class="page-text">Interested in future editions? Want to become an organizer? Have ideas to share?</p>
                <p class="page-callout-email"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
                <p class="page-note">Because the best workshops are built by the community, for the community.</p>
            </div>
        </div>
    </div>
</section>
