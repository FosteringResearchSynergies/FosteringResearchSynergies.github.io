{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin --prune)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh *)",
      "Bash(scripts/preview.sh)",
      "Bash(scripts/preview.sh *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(git -C * worktree remove *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh api *)",
      "Bash(gh repo edit *)",
      "Bash(gh release *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --mirror *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_protected_branches.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
