{#- Page data: title (required); description (optional: team text or repository facts only, otherwise
    the page has no description tags, see CLAUDE.md); structured_data (optional, the home only: the site
    and the organization in JSON-LD, from site.yml); stylesheets (optional list of extra stylesheet URLs,
    loaded after main.css); redirect_to (optional, the layout "redirect": the new address of a page that
    moved); noindex (optional: a page kept out of search engines, such as the 404). The icons are in
    src/assets/icons/, with /favicon.ico for the browsers that ask for it at the root. The font of the titles is preloaded: the home title is set in it and is the largest element
    of the page. -#}
{%- set canonicalUrl = (redirect_to or page.url) | canonical(site.url) %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
{%- if redirect_to %}
<meta http-equiv="refresh" content="0; url={{ redirect_to }}">
{%- endif %}
{%- if redirect_to or noindex %}
<meta name="robots" content="noindex">
{%- endif %}
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
<link rel="canonical" href="{{ canonicalUrl }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ canonicalUrl }}">
{%- if description %}
<meta property="og:description" content="{{ description }}">
{%- endif %}
{%- if structured_data %}
{%- set home = site.url + "/" %}
{%- set ld = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "WebSite", "@id": home + "#website", "name": site.name, "alternateName": site.short_name, "url": home },
        { "@type": "Organization", "@id": home + "#organization", "name": site.name, "alternateName": site.short_name,
          "url": home, "email": site.email, "description": site.description }
    ]
} %}
<script type="application/ld+json">{{ ld | dump | safe }}</script>
{%- endif %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/main.css">
{%- for href in stylesheets %}
<link rel="stylesheet" href="{{ href }}">
{%- endfor %}
